<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Backup to Google Drive is off, because everything the app stores stays on the device.
        See PRIVACY.md. On Android 12 and later, this may not stop a direct transfer to a new
        phone. Data extraction rules that control that come later.

        tools:ignore turns off two lint checks until the tasks that fix them are done:
        - DataExtractionRules: #68 sets the data extraction rules and removes this suppression.
        - MissingApplicationIcon: #120 adds the app icon and removes this suppression.
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        tools:ignore="DataExtractionRules,MissingApplicationIcon" />

</manifest>

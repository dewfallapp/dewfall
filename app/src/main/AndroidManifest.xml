<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The YouTube layer reaches YouTube over the network. OkHttp's manifest adds this permission
        too, but the app declares what it uses itself. See docs/architecture.md#network-access.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Backup to Google Drive is off, because everything the app stores stays on the device.
        See PRIVACY.md. On Android 12 and later, allowBackup="false" may not stop a direct
        transfer to a new phone, so the data extraction rules leave every file out of both. The full
        backup content does the same for Android 10 and 11. See
        docs/architecture.md#backups-and-phone-transfers.

        tools:ignore turns off one lint check until the task that fixes it is done:
        - MissingApplicationIcon: #120 adds the app icon and removes this suppression.
    -->
    <application
        android:name=".DewfallApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dewfall"
        tools:ignore="MissingApplicationIcon">

        <!--
            adjustResize lets screens move their content out of the keyboard's way through
            window insets, as edge-to-edge apps do.

            Phones stay in portrait, as docs/design/brief.md says. Android ignores this on displays
            whose smallest width is at least 600dp, so every screen also works in any other window
            (ADR 0006). tools:ignore turns off the two lint checks that discourage a fixed
            orientation, LockedOrientationActivity and DiscouragedApi, for MainActivity's element
            only: the brief keeps phones in portrait, and names the conflict with Android's
            guidance.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            App Startup's provider. It removes emoji2's startup initializer, which Compose brings
            in. It would ask the system's downloadable font provider for a newer emoji font, and
            network calls go only to YouTube and to services the user turns on. See
            docs/architecture.md#network-access. It also runs Dewfall's ImageLoaderInitializer,
            and removes WorkManager's initializer.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
            <meta-data
                android:name="io.github.dewfallapp.images.ImageLoaderInitializer"
                android:value="androidx.startup" />
            <!--
                WorkManager starts on demand with DewfallApplication's configuration, as
                WorkManager's custom configuration guide says. See ADR 0010.
            -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>

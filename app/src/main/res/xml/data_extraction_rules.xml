<?xml version="1.0" encoding="utf-8"?>
<!--
    Keeps every file of the app out of Google Drive backups and out of direct transfers to a new
    phone, on Android 12 and later. Everything the app stores stays on the device, as PRIVACY.md
    says. On some phones, android:allowBackup="false" alone doesn't stop a direct transfer.

    An exclude wins over an include, and these include nothing. Every domain is excluded on its
    own: Android backs up root, file, database and sharedpref, and their device_ twins, in
    separate passes that each start at their own folder, and an exclude matches only an exact
    path, so excluding root alone would leave the database in. external is the app's folder in
    external storage.

    There is no cross-platform-transfer section: an app opts in to a transfer to an iPhone with one,
    and Dewfall doesn't. See docs/architecture.md#backups-and-phone-transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
